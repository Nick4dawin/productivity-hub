{
  "name": "ProductivityHubMobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace ProductivityHubMobile.xcworkspace -scheme ProductivityHubMobile -configuration Release -destination generic/platform=iOS -archivePath ProductivityHubMobile.xcarchive archive"
  },
  "dependencies": {
